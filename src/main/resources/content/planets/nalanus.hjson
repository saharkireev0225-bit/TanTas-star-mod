{
    name: "nalanus"
    localizedName: "Наланус"
    description: "[gray]Спутник планеты Кетарсус.\n\n[lightgray]Каменистый мир с прожилками Кардона."
    
    generator: "SerpuloPlanetGenerator"
    defaultCore: "core-nucleus"
    
    // Родитель — Кетарсус
    parent: "ketarsus"
    solarSystem: "1_tantas-star"
    
    // Параметры спутника
    radius: 0.30
    minZoom: 0.2
    sectorSize: 1.5
    startSector: 1
    
    // Атмосфера (возвращаем, но делаем сероватой)
    atmosphereRadIn: 0.04
    atmosphereRadOut: 0.12
    atmosphereColor: "aa9977"
    
    // Орбита вокруг Кетарсуса
    orbitRadius: 7
    orbitTime: 22
    
    // Иконка
    iconColor: "bbaa99"
    icon: "planet"
    
    // Визуальные эффекты
    bloom: false
    alwaysUnlocked: true
    accessible: true
    visible: true
    
    // Правила сектора
    clearSectorOnLose: true
    allowLaunchSchematics: false
    allowLaunchLoadout: false
    allowWaveSimulation: true
    prebuildBase: false
    allowLaunchToNumbered: false
    
    // Скрываем стандартные ресурсы
